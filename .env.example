# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
PI_MODEL=claude-sonnet-5
PI_PLANNER_MODEL=claude-sonnet-5

# --- Target: Seezar Dashboard ---
PI_TARGET=seezar
PI_TARGET_BASE_URL=https://seezar-dashboard.seez.dev
# Seezar authenticates by emailed one-time code, so there is no password.
# Run `pi login` once and the browser session is persisted to .auth/
PI_TARGET_USERNAME=you@example.com
PI_TARGET_PASSWORD=

# --- Run limits / guardrails ---
PI_MAX_STEPS=80
PI_MAX_WALL_SECONDS=900
PI_MAX_USD=2.00
PI_HEADLESS=true
